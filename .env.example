# Copy to .env and fill in. Never commit the real .env.

# Postgres connection string.
#
# Local: start the bundled dev server with
#     npx prisma dev -d -n mta
#   then read the TCP URL from
#     npx prisma dev ls
#   The port is assigned at start and CHANGES between restarts.
#
# Production: the pooled connection string from Neon/Supabase/your host.
#   Managed Postgres normally requires TLS — keep ?sslmode=require.
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"

# Secret for signing/rotating session material.
# Generate a fresh one per environment:
#     openssl rand -base64 32
AUTH_SECRET="change-me-per-environment"

# ── PayPal ───────────────────────────────────────────────────
# Full walkthrough: docs/paypal-setup.md
# Subscriptions require a PayPal BUSINESS account (Personal cannot use them).

# sandbox | live
PAYPAL_ENV="sandbox"

# developer.paypal.com → Apps & Credentials → your app
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""

# developer.paypal.com → your app → Webhooks → the webhook's ID.
# Deliveries are verified against this; without it, verification throws and
# every webhook is rejected.
PAYPAL_WEBHOOK_ID=""

# Created by `npm run paypal:setup`, which prints these lines to paste.
# Sandbox and live have entirely different ids.
PAYPAL_PLAN_PRO_MONTHLY=""
PAYPAL_PLAN_PRO_YEARLY=""
PAYPAL_PLAN_PROPLUS_MONTHLY=""
PAYPAL_PLAN_PROPLUS_YEARLY=""
PAYPAL_PLAN_CREW_MONTHLY=""
PAYPAL_PLAN_CREW_YEARLY=""

# Public origin, used for PayPal's return/cancel URLs. Falls back to the
# request host, which is right locally but should be explicit in production.
APP_URL="http://localhost:3000"
